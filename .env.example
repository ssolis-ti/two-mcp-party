# AgentBridge / two-mcp-party — variables de entorno
#
# NINGUNA es obligatoria para levantar el hub: `npm start` arranca con valores
# por defecto y expone las herramientas de coordinacion (agentes, sesiones,
# mensajeria, memoria, tareas, workspaces).
#
# Las variables del gateway SOLO hacen falta para los modulos `hosted` y `swarm`
# (conversaciones entre modelos y planificacion con mente colmena). Sin ellas el
# hub arranca igual, pero esas herramientas fallaran al invocarse.
#
# Este archivo es una plantilla: copialo a `.env` y completa los valores.
# `.env` esta en .gitignore y nunca debe commitearse.

# ─────────────────────────── Hub MCP ───────────────────────────

# Puerto del servidor MCP (Streamable HTTP). Los agentes de la LAN se conectan
# a http://<TU_IP>:<PORT>/sse
PORT=3579

# Nivel de log: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Tiempo que el hub conserva una sesion de transporte HTTP inactiva antes de
# descartarla, en milisegundos. Debe superar con holgura el intervalo de polling
# de tus agentes; por debajo de eso reciben 404 al reconectar.
# Por defecto: 1800000 (30 minutos)
MCP_SESSION_TTL_MS=1800000

# ─────────────── Gateway de LLMs (modulos hosted y swarm) ───────────────
#
# El hub no integra proveedores: habla el dialecto de chat de OpenAI contra un
# gateway que se encarga de multiplexar proveedores y hacer fallback. Sirve
# cualquiera con API OpenAI-compatible; solo cambia la URL:
#
#   LiteLLM      http://localhost:4000
#   Bifrost      http://localhost:8080
#   vLLM         http://localhost:8000
#   LM Studio    http://localhost:1234
#   Ollama       http://localhost:11434
#   OpenRouter   https://openrouter.ai/api
#   OpenAI       https://api.openai.com
#
# Recorda ajustar tambien los nombres de modelo en hosted.config.js: deben ser
# los que exponga tu gateway (los lista bridge_list_models).

LLM_GATEWAY_URL=http://localhost:4000

# API key del gateway. Opcion A: la key directamente aqui.
LLM_GATEWAY_KEY=

# Opcion B: en vez de pegar la key, apunta a un archivo tipo .env del que se
# leera LLM_GATEWAY_KEY o LITELLM_MASTER_KEY. Util si ya la tenes en el deploy
# del gateway y no queres duplicarla. Si LLM_GATEWAY_KEY tiene valor, se ignora.
LLM_GATEWAY_ENV_FILE=

# Alias historicos, aceptados por compatibilidad: LITELLM_URL, LITELLM_KEY,
# LITELLM_MASTER_KEY y LITELLM_ENV_FILE. Las variables LLM_GATEWAY_* tienen
# precedencia si ambas estan definidas.
