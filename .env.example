# AgentBridge / two-mcp-party — variables de entorno
#
# NINGUNA es obligatoria para levantar el hub: `npm start` arranca con valores
# por defecto y expone las herramientas de coordinacion (agentes, sesiones,
# mensajeria, memoria, tareas, workspaces).
#
# Las variables de LiteLLM SOLO hacen falta para los modulos `hosted` y `swarm`
# (conversaciones entre modelos y planificacion con mente colmena). Sin ellas el
# hub arranca igual, pero esas herramientas fallaran al invocarse.
#
# Este archivo es una plantilla: copialo a `.env` y completa los valores.
# `.env` esta en .gitignore y nunca debe commitearse.

# ─────────────────────────── Hub MCP ───────────────────────────

# Puerto del servidor MCP (Streamable HTTP). Los agentes de la LAN se conectan
# a http://<TU_IP>:<PORT>/sse
PORT=3579

# Nivel de log: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# Tiempo que el hub conserva una sesion de transporte HTTP inactiva antes de
# descartarla, en milisegundos. Debe superar con holgura el intervalo de polling
# de tus agentes; por debajo de eso reciben 404 al reconectar.
# Por defecto: 1800000 (30 minutos)
MCP_SESSION_TTL_MS=1800000

# ──────────────────── LiteLLM (modulos hosted y swarm) ────────────────────

# URL del router LiteLLM. Por defecto: http://localhost:4000
LITELLM_URL=http://localhost:4000

# Master key del router. Opcion A: la key directamente aqui.
LITELLM_KEY=

# Opcion B: en vez de pegar la key, apunta a un archivo tipo .env del que se
# leera LITELLM_MASTER_KEY. Util si ya la tenes en el deploy de LiteLLM y no
# queres duplicarla. Si LITELLM_KEY tiene valor, esta se ignora.
LITELLM_ENV_FILE=
